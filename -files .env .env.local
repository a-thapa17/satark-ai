[1mdiff --git a/.env.example b/.env.example[m
[1mindex b0e50a4..d0272d9 100644[m
[1m--- a/.env.example[m
[1m+++ b/.env.example[m
[36m@@ -4,11 +4,60 @@[m
 # NEVER commit .env.local to source control.[m
 # ─────────────────────────────────────────────────────────────────────────────[m
 [m
[32m+[m[32m# ── Phase 1: optional AI layer ───────────────────────────────────────────────[m
 # Google Gemini API Key[m
 # Obtain a free key at https://aistudio.google.com/app/apikey[m
[31m-# Required for AI-enhanced analysis. If absent, the app runs in rules-only mode.[m
[32m+[m[32m# Required for AI-enhanced message analysis. If absent, the app runs in[m
[32m+[m[32m# rules-only mode.[m
 GEMINI_API_KEY=[m
 [m
 # Gemini model to use for structured analysis.[m
 # Recommended free-tier fast model (confirmed working, ~1–2s response):[m
 GEMINI_MODEL=gemini-flash-lite-latest[m
[32m+[m
[32m+[m[32m# ── Phase 2: URL reputation services (all optional) ──────────────────────────[m
[32m+[m[32m# Google Safe Browsing API key. Server-side only; never exposed to the client.[m
[32m+[m[32m# Obtain a key from Google Cloud Console with the Safe Browsing API enabled.[m
[32m+[m[32m# If absent, the UI clearly reports Safe Browsing as "Not configured".[m
[32m+[m[32mGOOGLE_SAFE_BROWSING_API_KEY=[m
[32m+[m
[32m+[m[32m# URLhaus Auth-Key from abuse.ch. Server-side only.[m
[32m+[m[32m# The adapter attempts an unauthenticated lookup when absent, but abuse.ch may[m
[32m+[m[32m# reject or rate-limit anonymous requests. Configure a key for reliable checks.[m
[32m+[m[32mURLHAUS_AUTH_KEY=[m
[32m+[m
[32m+[m[32m# ── Phase 2: URL analysis limits ─────────────────────────────────────────────[m
[32m+[m[32m# Maximum redirects followed per analysis (0–10). Default: 5.[m
[32m+[m[32mURL_ANALYSIS_MAX_REDIRECTS=5[m
[32m+[m
[32m+[m[32m# Per-hop network timeout in milliseconds (1,000–15,000). Default: 6,000.[m
[32m+[m[32mURL_ANALYSIS_HOP_TIMEOUT_MS=6000[m
[32m+[m
[32m+[m[32m# Total redirect-tracing budget in milliseconds (3,000–30,000). Default: 15,000.[m
[32m+[m[32mURL_ANALYSIS_TOTAL_TIMEOUT_MS=15000[m
[32m+[m
[32m+[m[32m# ── Phase 2: offline demo ────────────────────────────────────────────────────[m
[32m+[m[32m# Set to true to return clearly labelled SIMULATED results for the three[m
[32m+[m[32m# built-in sample URLs only. Other URLs still use live checks. Never enable[m
[32m+[m[32m# this in production.[m
[32m+[m[32mPHASE2_DEMO_MODE=false[m
[32m+[m
[32m+[m[32m# ── Rate limiting and reverse-proxy trust ────────────────────────────────────[m
[32m+[m[32m# Leave false when the app is directly exposed. Forwarded headers are[m
[32m+[m[32m# client-controlled unless a proxy you trust overwrites or appends them.[m
[32m+[m[32m# When behind one trusted reverse proxy, set this to true and keep hops at 1.[m
[32m+[m[32m# Increase hops only for the exact number of trusted proxies in front of Next.js.[m
[32m+[m[32mTRUST_PROXY_HEADERS=false[m
[32m+[m[32mTRUST_PROXY_HOPS=1[m
[32m+[m
[32m+[m[32m# ── Phase 3: help layer (no keys required) ───────────────────────────────────[m
[32m+[m[32m# Emergency guidance, safety playbooks, and phone-format/script checks run[m
[32m+[m[32m# locally. Evidence PDFs are built in memory by /api/evidence-pdf using[m
[32m+[m[32m# pdf-lib; no third-party service, API key, database, or report submission is[m
[32m+[m[32m# involved. Redaction is best-effort: never enter OTPs, passwords, full card[m
[32m+[m[32m# numbers, or Aadhaar numbers.[m
[32m+[m
[32m+[m[32m# ── Phase 4: language and accessibility (no keys required) ───────────────────[m
[32m+[m[32m# English/Hindi copy is bundled locally. The selected language is stored in[m
[32m+[m[32m# localStorage as satark_language; the intro marker uses sessionStorage as[m
[32m+[m[32m# satark_intro_seen. No translation service or API key is used.[m
