# ─────────────────────────────────────────────────────────────────────────────
# Satark AI — Environment Configuration Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Phase 1: optional AI layer ───────────────────────────────────────────────
# Google Gemini API Key
# Obtain a free key at https://aistudio.google.com/app/apikey
# Required for AI-enhanced message analysis. If absent, the app runs in
# rules-only mode.
GEMINI_API_KEY=

# Gemini model to use for structured analysis.
# Recommended free-tier fast model (confirmed working, ~1–2s response):
GEMINI_MODEL=gemini-flash-lite-latest

# ── Phase 2: URL reputation services (all optional) ──────────────────────────
# Google Safe Browsing API key. Server-side only; never exposed to the client.
# Obtain a key from Google Cloud Console with the Safe Browsing API enabled.
# If absent, the UI clearly reports Safe Browsing as "Not configured".
GOOGLE_SAFE_BROWSING_API_KEY=

# URLhaus Auth-Key from abuse.ch. Server-side only.
# The adapter attempts an unauthenticated lookup when absent, but abuse.ch may
# reject or rate-limit anonymous requests. Configure a key for reliable checks.
URLHAUS_AUTH_KEY=

# ── Phase 2: URL analysis limits ─────────────────────────────────────────────
# Maximum redirects followed per analysis (0–10). Default: 5.
URL_ANALYSIS_MAX_REDIRECTS=5

# Per-hop network timeout in milliseconds (1,000–15,000). Default: 6,000.
URL_ANALYSIS_HOP_TIMEOUT_MS=6000

# Total redirect-tracing budget in milliseconds (3,000–30,000). Default: 15,000.
URL_ANALYSIS_TOTAL_TIMEOUT_MS=15000

# ── Phase 2: offline demo ────────────────────────────────────────────────────
# Set to true to return clearly labelled SIMULATED results for the three
# built-in sample URLs only. Other URLs still use live checks. Never enable
# this in production.
PHASE2_DEMO_MODE=false

# ── Rate limiting and reverse-proxy trust ────────────────────────────────────
# Leave false when the app is directly exposed. Forwarded headers are
# client-controlled unless a proxy you trust overwrites or appends them.
# When behind one trusted reverse proxy, set this to true and keep hops at 1.
# Increase hops only for the exact number of trusted proxies in front of Next.js.
TRUST_PROXY_HEADERS=false
TRUST_PROXY_HOPS=1

# ── Phase 3: help layer (no keys required) ───────────────────────────────────
# Emergency guidance, safety playbooks, and phone-format/script checks run
# locally. Evidence PDFs are built in memory by /api/evidence-pdf using
# pdf-lib; no third-party service, API key, database, or report submission is
# involved. Redaction is best-effort: never enter OTPs, passwords, full card
# numbers, or Aadhaar numbers.

# ── Phase 4: language and accessibility (no keys required) ───────────────────
# English/Hindi copy is bundled locally. The selected language is stored in
# localStorage as satark_language; the intro marker uses sessionStorage as
# satark_intro_seen. No translation service or API key is used.
