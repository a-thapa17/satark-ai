# ─────────────────────────────────────────────────────────────────────────────
# Satark AI — Environment Configuration Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

# Google Gemini API Key
# Obtain a free key at https://aistudio.google.com/app/apikey
# Required for AI-enhanced analysis. If absent, the app runs in rules-only mode.
GEMINI_API_KEY=

# Gemini model to use for structured analysis.
# Recommended free-tier fast model (confirmed working, ~1–2s response):
GEMINI_MODEL=gemini-flash-lite-latest
